    TweenService:Create(bordaTecla, TweenInfo.new(0.1), {Color = ROXO_PRINCIPAL}):Play()
    conexaoTecla = UIS.InputBegan:Connect(function(e)
        if not ouvindoTecla then return end
        if e.UserInputType == Enum.UserInputType.Keyboard then
            if e.KeyCode == Enum.KeyCode.Escape then pararOuvir(nil); return end
