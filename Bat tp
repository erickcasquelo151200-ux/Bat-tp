-- // CONFIGURAÇÕES
local function saveConfig()
    local cfg = {
        autoBatKey = Keys.autoBat.Name,
        autoBatKeyType = Keys.autoBatType,
        mobileMode = State.mobileMode,
    }
    pcall(function() writefile("CSQHubBatTPConfig.json", HttpService:JSONEncode(cfg)) end)
end

local function loadConfig()
    local temArquivo = false
    pcall(function() temArquivo = isfile("CSQHubBatTPConfig.json") end)
    if not temArquivo then return end
    local ok, cfg = pcall(function() return HttpService:JSONDecode(readfile("CSQHubBatTPConfig.json")) end)
    if not ok or not cfg then return end
    if cfg.autoBatKey and Enum.KeyCode[cfg.autoBatKey] then Keys.autoBat = Enum.KeyCode[cfg.autoBatKey] end
    if cfg.autoBatKeyType then Keys.autoBatType = cfg.autoBatKeyType end
    if cfg.mobileMode ~= nil then State.mobileMode = cfg.mobileMode end
end

