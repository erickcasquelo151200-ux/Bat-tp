-- LÓGICA DO TACO
local function pegarTaco()
    local personagem = LP.Character; if not personagem then return nil end
    local ferramenta = personagem:FindFirstChild("Bat"); if ferramenta then return ferramenta end
    local mochila = LP:FindFirstChild("Backpack")
    if mochila then ferramenta = mochila:FindFirstChild("Bat"); if ferramenta then ferramenta.Parent = personagem; return ferramenta end end
    return nil
end

local function tentarBater()
    if State.hittingCooldown then return end; State.hittingCooldown = true
    pcall(function()
        local taco = pegarTaco(); if taco then
            taco:Activate(); local evento = taco:FindFirstChildWhichIsA("RemoteEvent")
            if evento then evento:FireServer() end
        end
    end)
    task.delay(0.08, function() State.hittingCooldown = false end)
end

local function pegarJogadorMaisProximo()
    if not hrp then return nil, math.huge end
    local alvo, distancia = nil, math.huge
    for _, jogador in pairs(Players:GetPlayers()) do
        if jogador ~= LP and jogador.Character then
            local parte = jogador.Character:FindFirstChild("HumanoidRootPart")
            if parte then local d = (hrp.Position - parte.Position).Magnitude; if d < distancia then distancia = d; alvo = jogador end end
        end
    end
    return alvo, distancia
end

-- CONFIGURAR PERSONAGEM
local function configurarPersonagem(personagem)
    task.wait(0.1)
    h = personagem:WaitForChild("Humanoid", 5); hrp = personagem:WaitForChild("HumanoidRootPart", 5)
end

LP.CharacterAdded:Connect(configurarPersonagem)
if LP.Character then task.spawn(configurarPersonagem, LP.Character) end

-- LOOP PRINCIPAL
RunService.Heartbeat:Connect(function()
    if not (State.autoBatToggled and h and hrp) then return end
    local alvo = pegarJogadorMaisProximo()
    if alvo and alvo.Character then
        local parteAlvo = alvo.Character:FindFirstChild("HumanoidRootPart")
        if parteAlvo then
            if sethiddenproperty then sethiddenproperty(hrp, "PhysicsRepRootPart", parteAlvo) end
            local posicao = parteAlvo.Position + Vector3.new(0, 0.9, 0)
            if (hrp.Position - posicao).Magnitude > 8 then hrp.CFrame = CFrame.new(posicao) end
            workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, parteAlvo.Position)
            tentarBater()
        end
    end
end)

